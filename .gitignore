# Generated by Cargo
/target
**/target/
# Curated liquid-glass reference frames, not a cargo build dir
!example/target/

# Generated by Gradle (Android)
**/.gradle/
**/build/

# Rust backup files
**/*.rs.bk

# IDE directories and files
.idea/
.vscode/
*.iml

# macOS
.DS_Store

# Logs
*.log

# Temporary test output
*.tmp

# Nested crate lockfiles (workspace uses root Cargo.lock)
crates/*/Cargo.lock

# Generated test artifacts
robot_test_summary.txt
verify_robot_summary_shard_*.txt
stress_robot_summary_shard_*.txt
docs/screenshots/text_scroll_exact_external/
docs/screenshots/text_scroll_exact_external_old_*/

# Misc
*.swp
*.swo

# Local tooling scratch files
.cranpose-tmp/
.codex
review.md

# Python bytecode from scripts/
__pycache__/

# Transient worktrees for background agents; never project content.
.claude/worktrees/

# Raw iPhone reference recordings. These are the source material behind the
# curated stills in example/target/ (see its README); the stills are the
# canonical reference and stay tracked, the raw video does not. Keep the
# source clips locally / in external storage instead.
example/iphone17_records/

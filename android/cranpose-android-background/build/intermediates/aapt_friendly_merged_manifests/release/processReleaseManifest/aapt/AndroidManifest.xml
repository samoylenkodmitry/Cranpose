<?xml version="1.0" encoding="utf-8"?>
<!--
    Background execution: the foreground service Cranpose starts while an
    application holds a background-work lease, and the permissions Android
    requires to start it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.cranpose.android.background" >

    <uses-sdk android:minSdkVersion="24" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <service
            android:name="dev.cranpose.android.CranposeBackgroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
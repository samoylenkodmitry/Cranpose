<?xml version="1.0" encoding="utf-8"?>
<!--
    The demo declares only what is specific to it. The activity, its launcher
    entry, the `android.app.lib_name` metadata and every framework permission
    come from the Cranpose library and the optional service modules the Gradle
    plugin added.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:label="Compose Demo"
        android:supportsRtl="true">
        <!--
            Diagnostics only: lets `adb shell simpleperf` sample this release
            build without making it debuggable, so frame-pacing profiles are
            taken on optimized code.
        -->
        <profileable android:shell="true" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
    The demo declares only its own application attributes. The activity, its
    launcher entry and the `android.app.lib_name` metadata come from the
    Cranpose library; the permissions come from what the platform crate's build
    script declares, which iOS and macOS read too.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Compose Demo"
        android:supportsRtl="true">
        <!--
            Diagnostics only: lets `adb shell simpleperf` sample this release
            build without making it debuggable, so frame-pacing profiles are
            taken on optimized code.
        -->
        <profileable android:shell="true" />
    </application>
</manifest>

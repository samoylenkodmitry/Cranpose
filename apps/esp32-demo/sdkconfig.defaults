CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Composition, layout and drawing run on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=49152
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# ESP32-S3 modules with 8 MB of octal PSRAM (N8R8, N16R8). Boards with quad
# PSRAM (N8R2) need CONFIG_SPIRAM_MODE_QUAD=y instead.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# A memory test of the whole PSRAM at every boot delays the first frame.
CONFIG_SPIRAM_MEMTEST=n

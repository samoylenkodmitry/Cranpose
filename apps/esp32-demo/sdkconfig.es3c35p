# Added to sdkconfig.defaults for the ES3C35P board: its USB-C port is the
# chip's USB Serial/JTAG, so the log goes there instead of to UART0.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The module's flash reads four bits a clock. The bootloader that ESP-IDF
# builds turns quad mode on, so flash it with the image (see the justfile).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# The code runs from flash. CONFIG_SPIRAM_XIP_FROM_PSRAM=y would copy the
# app's code and read-only data to the module's octal PSRAM at start, where a
# cache miss fills from a bus twice as wide as quad flash: it takes the
# demo's frame from 0.46 to 0.39 ms, as the framework's per-frame code is in
# IRAM either way, for 180 ms more before the first frame and 2.6 MB of the
# PSRAM.

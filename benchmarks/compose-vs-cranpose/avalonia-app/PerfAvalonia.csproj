<Project Sdk="Microsoft.NET.Sdk">

	<!-- One project for both heads: the Android app, and the desktop app
	     `desktop.py` runs. -->
	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>PerfAvalonia</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<ApplicationId>dev.perfcompare.avalonia</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<SupportedOSPlatformVersion>28</SupportedOSPlatformVersion>
		<RuntimeIdentifier>android-arm64</RuntimeIdentifier>
		<AndroidManifest>Android/AndroidManifest.xml</AndroidManifest>
		<MonoAndroidResourcePrefix>Android/Resources</MonoAndroidResourcePrefix>
	</PropertyGroup>

	<!-- What ships, at its best: trimmed, and fully AOT-compiled as the
	     Compose and MAUI apps are, rather than the profiled default; on a
	     desktop, Native AOT. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(TargetFramework)' == 'net10.0-android'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<RunAOTCompilation>true</RunAOTCompilation>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PublishAot>true</PublishAot>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
		<Compile Include="../shared-cs/PerfData.cs" Link="PerfData.cs" />
		<!-- The browser head is a project of its own. -->
		<Compile Remove="Browser/**" />
		<None Remove="Browser/**" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<PackageReference Include="Avalonia.Android" Version="12.1.4" />
		<Compile Remove="Desktop/**" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
		<Compile Remove="Android/**" />
	</ItemGroup>

</Project>

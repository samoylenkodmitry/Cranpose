// The chat beside the patchwork (`../README.md`): the blocks of an agent's
// answer, kept at the list's end, and a status line under them.
//
// In Slint's declarative idiom the blocks come from a Rust model. A token
// replaces the row of the one block it extends and no other row; the list
// follows its end by a binding on its own content height. The spinner turns
// and the status text takes its colors from `WallClock.frame`; the text is a
// row of single glyphs, as Slint has no gradient for text, and a token
// replaces only the glyph rows that differ.

import { WallClock } from "wall.slint";

export enum BlockKind {
    user,
    heading,
    paragraph,
    code,
    table,
    gif,
    buttons,
}

/// One line of code, its colored stretches as styled text.
export struct CodeLine {
    text: styled-text,
}

export struct TableRow {
    cells: [string],
    header: bool,
    shaded: bool,
}

/// One block: `text` for a question, a heading or a paragraph, `lines` for
/// code, `rows` for a table, `buttons` for a row of buttons.
export struct ChatItem {
    kind: BlockKind,
    text: string,
    lines: [CodeLine],
    rows: [TableRow],
    buttons: [string],
}

global Look {
    out property <color> panel: #0B0E1A;
    out property <color> bubble: #2B3A67;
    out property <color> dim: #64748B;
    out property <length> text: 12px;
    out property <length> code: 11px;
    /// The width of a line of code: the chat's, less the padding of the list and of the panel.
    out property <length> code-width: 320px - 32px;
}

component Block inherits VerticalLayout {
    in property <ChatItem> item;
    in property <image> gif-frame;
    if item.kind == BlockKind.user: HorizontalLayout {
        alignment: end;
        Rectangle {
            background: Look.bubble;
            border-radius: 10px;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text {
                    text: item.text;
                    font-size: Look.text;
                    color: white;
                    wrap: word-wrap;
                }
            }
        }
    }
    if item.kind == BlockKind.heading || item.kind == BlockKind.paragraph: Text {
        text: item.text;
        font-size: item.kind == BlockKind.heading ? 14px : Look.text;
        font-weight: item.kind == BlockKind.heading ? 700 : 400;
        color: white;
        wrap: word-wrap;
    }
    if item.kind == BlockKind.code: Rectangle {
        background: Look.panel;
        border-radius: 6px;
        clip: true;
        VerticalLayout {
            padding: 8px;
            for line in item.lines: StyledText {
                width: Look.code-width;
                text: line.text;
                default-font-family: "DejaVu Sans Mono";
                default-font-size: Look.code;
                default-color: white;
            }
        }
    }
    if item.kind == BlockKind.table: VerticalLayout {
        for row in item.rows: Rectangle {
            background: row.header || row.shaded ? Look.panel : transparent;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 3px;
                padding-bottom: 3px;
                for cell in row.cells: Text {
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                    text: cell;
                    font-size: Look.code;
                    font-weight: row.header ? 700 : 400;
                    color: white;
                    wrap: no-wrap;
                }
            }
        }
    }
    if item.kind == BlockKind.gif: HorizontalLayout {
        alignment: start;
        Image {
            source: gif-frame;
            width: 64px;
            height: 64px;
        }
    }
    if item.kind == BlockKind.buttons: HorizontalLayout {
        alignment: start;
        spacing: 8px;
        for label in item.buttons: Rectangle {
            background: Look.bubble;
            border-radius: 6px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text {
                    text: label;
                    font-size: Look.text;
                    font-weight: 700;
                    color: white;
                    wrap: no-wrap;
                }
            }
        }
    }
}

export component Chat inherits Rectangle {
    in property <[ChatItem]> items;
    in property <[string]> status;
    in property <image> spinner;
    in property <image> gif-frame;
    // Where the gradient's first pass starts, 6 points further each frame.
    property <float> shimmer-start: Math.mod(WallClock.frame * 6, 120);
    background: #14182B;
    list := Flickable {
        y: 0;
        width: parent.width;
        height: parent.height - 28px;
        // The list shows its end once its blocks are taller than it.
        content-y: Math.min(0px, self.height - self.content-height);
        VerticalLayout {
            x: 0;
            width: list.width;
            padding: 8px;
            spacing: 8px;
            alignment: start;
            for item in items: Block {
                item: item;
                gif-frame: gif-frame;
            }
        }
    }
    Rectangle {
        y: parent.height - 28px;
        width: parent.width;
        height: 28px;
        background: Look.panel;
        Image {
            x: 8px;
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            source: spinner;
            transform-rotation: WallClock.frame * 12deg;
        }
        HorizontalLayout {
            x: 30px;
            height: parent.height;
            alignment: start;
            for glyph in status: Text {
                property <float> along: Math.mod(Math.mod(self.x / 1px - shimmer-start, 120) + 120, 120) / 120;
                text: glyph;
                font-size: Look.text;
                color: Look.dim.mix(white, 1 - Math.abs(2 * along - 1));
                vertical-alignment: center;
                wrap: no-wrap;
            }
        }
    }
}

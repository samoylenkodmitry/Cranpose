# LVGL settings of the benchmark. The ESP-IDF settings come from the Cranpose
# demo's files, which the build lists after this one.
CONFIG_LV_COLOR_DEPTH_16=y
# The optimization esp-idf-sys gives ESP-IDF's C code in the demo's release
# build, -O2. idf.py builds at -Og unless told otherwise.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The dashboard's objects take more than LVGL's 64 KB pool: LVGL allocates
# from the ESP-IDF heap, as Cranpose does.
CONFIG_LV_USE_CLIB_MALLOC=y
# A frame every 16 ms while something changes, as the demo's 60 Hz.
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
# LVGL's options for speed: cached style lookups and its drawing functions in
# IRAM.
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y

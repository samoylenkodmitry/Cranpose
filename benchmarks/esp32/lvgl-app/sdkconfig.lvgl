# LVGL settings of the benchmark. The ESP-IDF settings come from the Cranpose
# demo's files, which the build lists after this one.
CONFIG_LV_COLOR_DEPTH_16=y
# A frame every 16 ms while something changes, as the demo's 60 Hz.
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_22=y
# LVGL's options for speed: cached style lookups and its drawing functions in
# IRAM.
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y

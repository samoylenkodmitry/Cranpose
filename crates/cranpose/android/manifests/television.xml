<?xml version="1.0" encoding="utf-8"?>
<!--
    An application for TVs as well: the Android TV launcher lists it, a remote
    drives it, and Google Play offers it to devices without a touchscreen.
    The application supplies its 320 by 180 launcher banner as
    `@drawable/tv_banner`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application android:banner="@drawable/tv_banner">
        <activity android:name="dev.cranpose.android.CranposeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

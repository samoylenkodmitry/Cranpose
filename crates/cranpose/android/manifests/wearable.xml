<?xml version="1.0" encoding="utf-8"?>
<!--
    The link to the same application on the paired phone or watch: Google Play
    services starts CranposeWearableService when the paired device sends a
    message or opens a stream. The Data Layer needs no permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name="dev.cranpose.android.CranposeWearableService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/" />
            </intent-filter>
        </service>
    </application>
</manifest>
